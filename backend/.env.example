# Copy to backend/.env (gitignored) and fill in real values to enable social login (KAN-7).
# The app boots and runs fine with these blank — only initiating a real OAuth flow needs them.

# Facebook Developer app (also covers Instagram, which authenticates through Facebook
# Login): https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# LinkedIn Developer app: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Apple: requires a paid Apple Developer account. Register a Services ID with "Sign In
# with Apple" enabled, and a private key: https://developer.apple.com/account/resources
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 private key's full contents (including the -----BEGIN/END----- lines).
APPLE_PEM=

# Resend (KAN-27): https://resend.com/api-keys — until a custom domain is verified there,
# sandbox mode only allows sending from onboarding@resend.dev to the account's own signup
# email, so MAILER_FROM_EMAIL must stay onboarding@resend.dev until a domain is added.
RESEND_API_KEY=
MAILER_FROM_EMAIL=onboarding@resend.dev

