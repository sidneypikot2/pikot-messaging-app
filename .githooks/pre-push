#!/usr/bin/env bash
# Refuses pushes to the two protected branches, from any local branch: staging only
# changes through a merged pull request, main only through a release (staging -> main).
# Git feeds one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/staging)
      echo "pre-push: refusing to push to ${remote_ref#refs/heads/} — push the task branch and open a pull request." >&2
      exit 1 ;;
  esac
done
exit 0
