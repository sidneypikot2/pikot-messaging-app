#!/usr/bin/env bash
# Runs shellcheck on every shell script in the repo: the Claude Code hooks, the git hooks
# and script/. Uses a local shellcheck when there is one (CI), otherwise the official
# container. Run from anywhere.
set -euo pipefail

cd "$(dirname "$0")/.."

files=()
while IFS= read -r file; do
  # Shell scripts only: script/ and .githooks/ have no extensions, so go by the shebang.
  head -n1 "$file" | grep -Eq '^#!.*\b(ba)?sh\b' && files+=("$file")
done < <(git ls-files --cached --others --exclude-standard -- .claude/hooks .claude/cloud-setup.sh '.claude/skills/*/scripts' .githooks script)

if command -v shellcheck >/dev/null; then
  shellcheck --severity=warning "${files[@]}"
else
  docker run --rm -e LC_ALL=C.UTF-8 -v "$PWD:/mnt:ro" -w /mnt koalaman/shellcheck:stable --severity=warning "${files[@]}"
fi
echo "lint-shell: ok (${#files[@]} scripts)"
