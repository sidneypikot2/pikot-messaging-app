#!/usr/bin/env bash
# Scans the repository's git history for committed secrets with gitleaks, in its own
# container. The repository is public, so a secret that was ever committed is exposed
# even if a later commit removed it.
#
#   script/scan-secrets          every commit on every ref this clone has
#
# Findings are printed redacted (rule, file, commit — never the secret). A false positive
# is silenced by adding its fingerprint to .gitleaksignore. In CI the clone is shallow,
# so this checks the files as they are in the commit under test. Needs Docker only.
set -euo pipefail

cd "$(dirname "$0")/.."
image="ghcr.io/gitleaks/gitleaks:v8.30.1"

root="$(git rev-parse --show-toplevel)"
# In a worktree .git is a pointer to the main checkout's .git; mount both at their real
# paths so the pointer still resolves inside the container.
common="$(git rev-parse --path-format=absolute --git-common-dir)"

docker run --rm \
  -v "$root:$root:ro" -v "$common:$common:ro" -w "$root" \
  -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e "GIT_CONFIG_VALUE_0=*" \
  "$image" git --redact --no-banner --no-color --verbose --log-opts="--all" "$root" \
  && echo "scan-secrets: ok"
