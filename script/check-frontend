#!/usr/bin/env bash
# Static checks for the frontend's structural rules (.claude/rules/frontend.md). The
# frontend has no test suite and no Node toolchain, so this is plain bash + grep.
# Run from anywhere; exits 1 and lists every violation. Used by CI and by the
# .claude/hooks/check-frontend.sh hook.
set -uo pipefail

cd "$(dirname "$0")/../frontend" || exit 1
errors=0
fail() { echo "check-frontend: $1" >&2; errors=$((errors + 1)); }

# 1. Only js/api.js talks to the backend.
while IFS= read -r hit; do
  fail "fetch() outside js/api.js — add a method to Api instead: $hit"
done < <(grep -nE '(^|[^A-Za-z0-9_.])fetch\(' js/*.js *.html 2>/dev/null | grep -v '^js/api\.js:')

# 2. Classic scripts sharing globals — no ES modules.
while IFS= read -r hit; do
  fail "ES module syntax (scripts are classic, loaded in order by the HTML): $hit"
done < <(grep -nE '^[[:space:]]*(import|export)[[:space:]{*]' js/*.js; grep -nE '<script[^>]*type="module"' *.html)

# 3. Every local <script src> / <link href> points at a file that exists.
while IFS=: read -r page ref; do
  case "$ref" in http://*|https://*|//*|data:*|"") continue ;; esac
  [[ -f "${ref%%\?*}" ]] || fail "$page references missing file: $ref"
done < <(grep -oE '<(script|link)[^>]*(src|href)="[^"]+"' *.html | sed -E 's/^([^:]+):.*(src|href)="([^"]+)"$/\1:\3/')

# 4. Every script and stylesheet is loaded by some page (a new file must be added to its HTML).
for file in js/*.js css/*.css css/messenger/*.css; do
  grep -qF "\"$file\"" *.html || fail "$file is not loaded by any page — add it to the right HTML file, in load order"
done

# 5. No script is loaded twice by the same page (a double load redeclares its globals).
for page in *.html; do
  while IFS= read -r dup; do
    fail "$page loads $dup more than once"
  done < <(grep -oE '<script[^>]*src="[^"]+"' "$page" | sed -E 's/.*src="([^"]+)"/\1/' | sort | uniq -d)
done

if (( errors > 0 )); then
  echo "check-frontend: $errors problem(s)" >&2
  exit 1
fi
echo "check-frontend: ok"
