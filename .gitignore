# macOS
.DS_Store

# --- Claude Code ---
/.claude/scheduled_tasks.lock
/.claude/settings.local.json
/.claude/worktrees/
/CLAUDE.local.md

# Per-worktree Compose ports, written by script/worktree-env
/.env

# --- Rails backend ---
/backend/.bundle
/backend/.env*
!/backend/.env.example
/backend/log/*
/backend/tmp/*
!/backend/log/.keep
!/backend/tmp/.keep
/backend/tmp/pids/*
!/backend/tmp/pids/
!/backend/tmp/pids/.keep
/backend/storage/*
!/backend/storage/.keep
/backend/tmp/storage/*
!/backend/tmp/storage/
!/backend/tmp/storage/.keep
/backend/config/*.key
/backend/config/master.key
/backend/public/assets
/backend/.kamal/secrets

# --- Tooling ---
/tools/frontend-lint/node_modules

# --- Node / frontend (if a build step is added later) ---
/frontend/node_modules
/frontend/dist
